    "id": "d351239c"
   },
   "outputs": [],
   "source": [
    "# Сортируем данные по дате заказа для корректного определения первого и последнего заказов\n",
    "df_sorted = df.sort_values(by='order_dt')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 20,
   "id": "e374ef11",
   "metadata": {
    "id": "e374ef11"
   },
   "outputs": [],
   "source": [
    "# Создаем агрегацию по user_id\n",
    "user_profile = df_sorted.groupby('user_id').agg(\n",
    "    # Даты первого и последнего заказа\n",
    "    first_order_dt=('order_dt', 'min'),\n",
    "    last_order_dt=('order_dt', 'max'),\n",
    "     # Первый заказ - устройство, регион, партнер, жанр\n",
    "    first_device=('device_type_canonical', 'first'),\n",
    "    first_region=('region_name', 'first'),\n",
    "    first_partner=('service_name', 'first'),\n",
    "    first_genre=('event_type_main', 'first'),\n",
    "    # общее количество заказов\n",
    "    total_orders=('order_id', 'nunique'),\n",
    "    # средняя выручка с одного заказа в рублях и среднее количество билетов в заказе  \n",
    "    avg_revenue_per_order=('revenue_rub', 'mean'),\n",
    "    avg_tickets_per_order=('tickets_count', 'mean')\n",
    ").reset_index()\n",
    "# среднее время между заказами\n",
    "user_profile['avg_days_between_orders'] = (\n",
    "    user_profile['last_order_dt'] - user_profile['first_order_dt']\n",
    ") / (user_profile['total_orders'] - 1)\n",
    "\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 21,
   "id": "65e2a758",
   "metadata": {
    "id": "65e2a758"
   },
   "outputs": [],
   "source": [
    "# Добавляем бинарные признаки\n",
    "user_profile['is_two'] = (user_profile['total_orders'] >= 2).astype(int)\n",
    "user_profile['is_five'] = (user_profile['total_orders'] >= 5).astype(int)\n",
    "user_profile['avg_days_between_orders'] = user_profile['avg_days_between_orders'].dt.days"
   ]
  },
