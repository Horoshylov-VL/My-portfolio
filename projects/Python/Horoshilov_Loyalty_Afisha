    "query = '''\n",
    "WITH set_config_precode AS (\n",
    "    SELECT set_config('synchronize_seqscans', 'off', true)\n",
    "),\n",
    "filtered_purchases AS (\n",
    "    SELECT *\n",
    "    FROM afisha.purchases\n",
    "    WHERE device_type_canonical IN ('mobile', 'desktop')\n",
    "),\n",
    "purchases_with_lag AS (\n",
    "    SELECT\n",
    "        fp.user_id,\n",
    "        fp.device_type_canonical,\n",
    "        fp.order_id,\n",
    "        fp.created_dt_msk AS order_dt,\n",
    "        fp.created_ts_msk AS order_ts,\n",
    "        fp.currency_code,\n",
    "        fp.revenue,\n",
    "        fp.tickets_count,\n",
    "        fp.event_id,\n",
    "        fp.service_name,\n",
    "        e.event_name_code AS event_name,\n",
    "        e.event_type_main,\n",
    "        r.region_name,\n",
    "        c.city_name,\n",
    "        EXTRACT(DAY FROM (fp.created_dt_msk - LAG(fp.created_dt_msk) OVER (PARTITION BY fp.user_id ORDER BY fp.created_dt_msk)))::INTEGER AS days_since_prev\n",
    "    FROM filtered_purchases fp\n",
    "    JOIN afisha.events e ON fp.event_id = e.event_id\n",
    "    JOIN afisha.venues v ON e.venue_id = v.venue_id\n",
    "    JOIN afisha.city c ON e.city_id = c.city_id\n",
    "    JOIN afisha.regions r ON c.region_id = r.region_id\n",
    "    WHERE e.event_type_main != 'фильм'\n",
    ")\n",
    "SELECT *\n",
    "FROM purchases_with_lag\n",
    "ORDER BY user_id ASC\n",
    "''' \n",
    "\n",
    "df = pd.read_sql_query(query, con=engine) "
   ]
