    "\n",
    "curs_df = pd.read_csv('https://code.s3.yandex.net/datasets/final_tickets_tenge_df.csv')\n",
    "\n",
    "# 1. Определяем реальное имя столбца с датой (замените 'data' на фактическое имя, если отличается)\n",
    "date_col = 'data'  # проверьте через curs_df.columns\n",
    "\n",
    "# 2. Приводим дату к datetime и нормализуем до начала дня (убираем время)\n",
    "curs_df[date_col] = pd.to_datetime(curs_df[date_col]).dt.normalize()\n",
    "\n",
    "# 3. Делаем дату индексом\n",
    "curs_df = curs_df.set_index(date_col)\n",
    "\n",
    "# Основной DataFrame\n",
    "df['revenue'] = pd.to_numeric(df['revenue'], errors='coerce')\n",
    "df['order_date'] = pd.to_datetime(df['order_dt']).dt.normalize()\n",
    "\n",
    "# 4. Присоединяем курс по дате (merge)\n",
    "df = df.merge(curs_df[['curs']], left_on='order_date', right_index=True, how='left')\n",
    "\n",
    "# 5. Конвертируем выручку\n",
    "mask_kzt = df['currency_code'] == 'kzt'\n",
    "mask_rub = df['currency_code'] == 'rub'\n",
    "\n",
    "df.loc[mask_kzt, 'revenue_rub'] = df.loc[mask_kzt, 'revenue'] * df.loc[mask_kzt, 'curs'] / 100\n",
    "df.loc[mask_rub, 'revenue_rub'] = df.loc[mask_rub, 'revenue']\n",
    "\n",
    "# Опционально: удаляем вспомогательный столбец с курсом\n",
    "df = df.drop(columns=['curs'], errors='ignore')"
   ]
