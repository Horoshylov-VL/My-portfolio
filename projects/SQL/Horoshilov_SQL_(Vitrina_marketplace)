-- Подсчёт ТОП - регионов по количеству заказов
--title: Витрина Хорошилова
WITH top_regions AS (
SELECT
	region
FROM
	(
	SELECT
		u.region,
		ROW_NUMBER() OVER (
		ORDER BY COUNT(o.order_id) DESC) AS rn
	FROM
		ds_ecom.users AS u
	INNER JOIN ds_ecom.orders AS o ON
		u.buyer_id = o.buyer_id
	WHERE
		o.order_status IN ('Доставлено', 'Отменено')
	GROUP BY
		u.region
    ) AS t
WHERE
	rn <= 3
),
--Заказы клиентов
orders_filtr AS (
SELECT
	u.user_id,
	o.order_id,
	o.buyer_id,
	op.payment_type,
	op.payment_sequential,
	op.payment_installments,
	oi.price,
	oi.delivery_cost,
	ore.review_score,
	ore.review_id,
	o.order_purchase_ts,
	o.order_status
FROM
	ds_ecom.order_payments AS op
INNER JOIN ds_ecom.orders AS o ON
	op.order_id = o.order_id
INNER JOIN ds_ecom.users AS u ON
	o.buyer_id = u.buyer_id
LEFT JOIN ds_ecom.order_items AS oi ON
	o.order_id = oi.order_id
LEFT JOIN ds_ecom.order_reviews AS ore ON
	o.order_id = ore.order_id
INNER JOIN top_regions tr ON
	u.region = tr.region
WHERE
	o.order_status IN ('Доставлено', 'Отменено')
),
-- Использовал ли клиент денежный перевод хотя бы один раз в качестве первого способа
used_money_transfer AS (
   SELECT DISTINCT
        order_id,
        CASE
            WHEN FIRST_VALUE(payment_type) OVER (
                PARTITION BY order_id
                ORDER BY payment_sequential ASC
            ) = 'денежный перевод' THEN 1
            ELSE 0
        END AS used_money_transfer
    FROM orders_filtr
),
-- Количество заказов, оплаченных с помощью промокодов.
num_orders_with_promo AS (
SELECT
	order_id,
	CASE
		WHEN SUM(CASE WHEN payment_type = 'промокод' THEN 1 ELSE 0 END) > 0 THEN 1
		ELSE 0
	END AS num_orders_with_promo
FROM
	orders_filtr
GROUP BY
	order_id
),
-- количество заказов, оплаченных в рассрочку
installment_stats AS (
SELECT
	order_id,
	COUNT(DISTINCT CASE WHEN payment_installments > 1 THEN order_id END) AS num_installment_orders,
	CASE
		WHEN COUNT(DISTINCT CASE WHEN payment_installments > 1 THEN order_id END) > 0 THEN 1
		ELSE 0
	END AS used_installments
FROM
	orders_filtr
GROUP BY
	order_id
),
--общая стоимость всех заказов, доставленных пользователю
total_stats AS (
    SELECT
        o.order_id,
        SUM(oi.price + oi.delivery_cost) AS total_order_cost
    FROM ds_ecom.orders AS o
    JOIN ds_ecom.order_items AS oi ON o.order_id = oi.order_id
    WHERE o.order_status = 'Доставлено'
    GROUP BY o.order_id
    ),
--средняя оценка, которую пользователь выставляет своим заказам
rating_stats AS (
SELECT
	 o.order_id,
	AVG(CASE
            WHEN ore.review_score BETWEEN 10 AND 50 THEN ore.review_score / 10
            WHEN ore.review_score BETWEEN 1 AND 5 THEN ore.review_score
            ELSE NULL
        END) AS avg_review
FROM
	ds_ecom.orders AS o
JOIN ds_ecom.order_reviews AS ore ON
	o.order_id = ore.order_id
WHERE
	o.order_status IN ('Доставлено', 'Отменено')
GROUP BY
	o.order_id
),
--  дата и время первого заказа и дата и время последнего заказа
order_ts_stats AS (
SELECT
	o.order_id,
	FIRST_VALUE(o.order_purchase_ts) OVER (PARTITION BY u.user_id, region
ORDER BY
	o.order_purchase_ts) AS first_order_ts,
	LAST_VALUE(o.order_purchase_ts) OVER (PARTITION BY u.user_id, region
ORDER BY
	o.order_purchase_ts 
        ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS last_order_ts
FROM
	ds_ecom.orders AS o
INNER JOIN ds_ecom.users AS u ON
	o.buyer_id = u.buyer_id
WHERE
	order_status = 'Доставлено'
),
--статус отмены
canceled_orders AS (
SELECT
        order_id,
        COUNT(order_id) AS num_canceled_orders
    FROM ds_ecom.orders
    WHERE order_status = 'Отменено'
    GROUP BY order_id
),
--наличие отзыва для каждого заказа
orders_with_review AS (
SELECT
	DISTINCT o.order_id,
	CASE
		WHEN MAX(ore.review_id) IS NOT NULL THEN 1
		ELSE 0
	END AS review
FROM
	ds_ecom.orders AS o
LEFT JOIN ds_ecom.order_reviews AS ore ON
	o.order_id = ore.order_id
WHERE
	o.order_status IN ('Доставлено', 'Отменено')
GROUP BY
	o.order_id
)
--Внешний запрос с выводом всех рассчётов
SELECT
	u.user_id,
	u.region,
	COALESCE(MIN(first_order_ts), '0001-01-01'::timestamp) AS first_order_ts,
	COALESCE(MAX(last_order_ts), '0001-01-01'::timestamp) AS last_order_ts,
	COALESCE(MAX(last_order_ts) - MIN(first_order_ts), '0 days'::INTERVAL) AS lifetime,
	COUNT(DISTINCT o.order_id) AS total_orders,
	AVG(rs.avg_review) AS avg_order_rating,
	SUM(owr.review) AS num_orders_with_rating,
	COALESCE(SUM(co.num_canceled_orders), 0) AS num_canceled_orders,
	ROUND(COALESCE(SUM(co.num_canceled_orders) * 1.0 / NULLIF(COUNT(DISTINCT o.order_id), 0), 0), 3) AS canceled_orders_ratio,
	COALESCE(SUM(ta.total_order_cost), 0) AS total_order_costs,
	COALESCE(AVG(ta.total_order_cost), 0) AS avg_order_cost,
	COALESCE(SUM(i.num_installment_orders), 0) AS num_installment_orders,
	COALESCE(SUM(n.num_orders_with_promo), 0) AS num_orders_with_promo,
	COALESCE(MAX(m.used_money_transfer), 0) AS used_money_transfer,
	COALESCE(MAX(i.used_installments), 0) AS used_installments,
    COALESCE(MAX(num_canceled_orders), 0) AS used_cancel
FROM
	ds_ecom.users u
INNER JOIN top_regions AS tr ON
	u.region = tr.region
INNER JOIN ds_ecom.orders AS o ON
	u.buyer_id = o.buyer_id
LEFT JOIN num_orders_with_promo AS n ON
	o.order_id = n.order_id
LEFT JOIN used_money_transfer AS m ON
	o.order_id = m.order_id
LEFT JOIN installment_stats AS i ON
	o.order_id = i.order_id
LEFT JOIN total_stats AS ta ON
	o.order_id = ta.order_id
LEFT JOIN rating_stats AS rs ON
	o.order_id = rs.order_id
LEFT JOIN order_ts_stats AS ots ON
	o.order_id = ots.order_id
LEFT JOIN canceled_orders AS co ON
	o.order_id = co.order_id
LEFT JOIN orders_with_review owr ON
	o.order_id = owr.order_id
WHERE
	o.order_status IN ('Доставлено', 'Отменено')
GROUP BY
	u.user_id,
	u.region
ORDER BY
	total_orders DESC;

