/* Задача 1. Сегментация пользователей 
*/

SELECT *
FROM ds_ecom.product_user_features
SELECT
	CASE
		WHEN total_orders = 1 THEN '1 заказ'
		WHEN total_orders BETWEEN 2 AND 5 THEN '2-5 заказов'
		WHEN total_orders BETWEEN 6 AND 10 THEN '6-10 заказов'
		WHEN total_orders >= 11 THEN '11 и более заказов'
	END AS order_category,
	COUNT(user_id) AS user_count,
	-- Общее количество пользователей в сегменте
	ROUND(AVG(total_orders), 3) AS avg_orders,
	-- Среднее количество заказов 
	ROUND(AVG(avg_order_cost), 3) AS avg_order_cost
FROM
	ds_ecom.product_user_features
GROUP BY
	CASE
		WHEN total_orders = 1 THEN '1 заказ'
		WHEN total_orders BETWEEN 2 AND 5 THEN '2-5 заказов'
		WHEN total_orders BETWEEN 6 AND 10 THEN '6-10 заказов'
		WHEN total_orders >= 11 THEN '11 и более заказов'
	END
ORDER BY
	user_count DESC;
  

/* Задача 2. Ранжирование пользователей 
*/

SELECT
	user_id,
	total_orders,
	avg_order_cost
FROM
	ds_ecom.product_user_features
WHERE
	total_orders >= 3
ORDER BY
	avg_order_cost DESC
LIMIT 15;


/* Задача 3. Статистика по регионам. 
*/

SELECT
	region,
	COUNT(DISTINCT user_id) AS total_users,
	SUM (total_orders) AS total_orders_region,
	ROUND(AVG(total_order_costs), 2) AS avg_order_cost,
	ROUND(
        SUM(num_installment_orders) / SUM(total_orders),
        4
    ) AS doly_zakazov_rassrock,
	ROUND(
        SUM(num_orders_with_promo)/ SUM(total_orders),
        4
    ) AS doly_zakazov_promo,
	ROUND(
        COUNT(CASE WHEN used_cancel > 0 THEN 1 END)::NUMERIC / COUNT(DISTINCT user_id),
        4) AS doly_otmen_polzovateley
FROM
	ds_ecom.product_user_features
GROUP BY
	region
ORDER BY
	total_orders_region DESC;

/* Задача 4. Активность пользователей по первому месяцу заказа в 2023 году
*/

SELECT
	EXTRACT(MONTH FROM first_order_ts) AS first_order_month,
	COUNT(DISTINCT user_id) AS total_users,
	SUM(total_orders) AS total_orders,
	ROUND(AVG(avg_order_cost), 2) AS avg_order_cost,
	ROUND(AVG(avg_order_rating), 2) AS avg_order_rating,
	ROUND(
        SUM(CASE WHEN used_money_transfer = 1 THEN 1 ELSE 0 END)::NUMERIC / COUNT(DISTINCT user_id),
        4
    ) AS doly_pri_oplate_dengami,
	AVG(lifetime) AS avg_lifetime
FROM
	ds_ecom.product_user_features
WHERE
	EXTRACT(YEAR FROM first_order_ts) = 2023
GROUP BY
	EXTRACT(MONTH FROM first_order_ts)
ORDER BY
	first_order_month;





