-- Возможные аномалии или некорректные значения в данных
WITH order_totals AS (
  SELECT
    order_id,
    SUM(price + delivery_cost) AS total_cost
  FROM ds_ecom.order_items
  GROUP BY order_id
)
SELECT
  COUNT(*) AS total_orders,
  SUM (total_cost) AS SUM,
  MIN(total_cost) AS min_cost,
  MAX(total_cost) AS max_cost,
  AVG(total_cost) AS avg_cost,
  PERCENTILE_CONT(0.5) WITHIN GROUP (ORDER BY total_cost) AS median_cost,
  STDDEV(total_cost) AS stddev_cost
FROM order_totals; 

--Промежуток времени, за который представлены данные 

-- Дата первого заказа
WITH start_date AS (
SELECT
  MIN(order_purchase_ts) AS Mins 
FROM ds_ecom.orders
WHERE order_delivered_ts IS NOT NULL
),

-- Дата последнего заказа
end_date AS 
(SELECT
  MAX(order_purchase_ts) AS MAXs
FROM ds_ecom.orders
)
-- Разница между первым и последним заказов в днях
SELECT
  sd.Mins AS first_order_date,
  ed.MAXs AS last_order_date,
  DATE_PART('day', ed.MAXs - sd.Mins) AS total_days
FROM start_date sd, end_date ed;

-- Распределение заказов по месяцам
SELECT
  DATE_TRUNC('month', order_purchase_ts) AS month_year,
  COUNT(*) AS orders_count,
  SUM () OVER ()
FROM ds_ecom.orders
GROUP BY DATE_TRUNC('month', order_purchase_ts)
ORDER BY month_year;


