-- Часть 1. Исследовательский анализ данных
-- Задача 1. Исследование доли платящих игроков
-- 1.1. Доля платящих пользователей по всем данным:
-- Напишите ваш запрос здесь

--name: Запрос 1.1
WITH users AS (
SELECT
	(
	SELECT
		COUNT (id)
	FROM
		fantasy.users) AS total_users,
	(
	SELECT
		COUNT (id)
	FROM
		fantasy.users
	WHERE
		payer = 1) AS payer_users
)
-- Запрос считает кол-во зарегестрированных игроков и платных игроков 
SELECT
	total_users,
	payer_users,
	ROUND((payer_users::NUMERIC / total_users::NUMERIC), 4) AS user_share
FROM
	users;
	--  доля платных игроков от общего количества пользователей, зарегистрированных в игре.


	
	
-- 1.2. Доля платящих пользователей в разрезе расы персонажа:
-- Напишите ваш запрос здесь

--name: Запрос 1.2
WITH rasa_payer_users AS (
SELECT
	race,
	COUNT (id) AS payer_users_rase
FROM
	fantasy.race AS r
INNER JOIN fantasy.users AS u ON
	r.race_id = u.race_id
WHERE
	payer = 1
GROUP BY
	race
),
-- количество платящих игроков этой расы 
total_users_race AS (
SELECT
	race,
	COUNT (id) AS total_users_race
FROM
	fantasy.race AS r
INNER JOIN fantasy.users AS u ON
	r.race_id = u.race_id
GROUP BY
	race
)

-- общее количество зарегистрированных игроков этой расы
SELECT
	pu.race,
	pu.payer_users_rase,
	ur.total_users_race,
	ROUND ((pu.payer_users_rase ::NUMERIC / ur.total_users_race :: NUMERIC),
	4) AS payer_share_by_race
	-- доля платящих игроков среди всех зарегистрированных игроков этой расы.
FROM
	rasa_payer_users AS pu
INNER JOIN total_users_race AS ur ON
	pu.race = ur.race
ORDER BY
	total_users_race DESC;




-- Задача 2. Исследование внутриигровых покупок
-- 2.1. Статистические показатели по полю amount:
-- Напишите ваш запрос здесь

--name: Запрос 2.1
SELECT
	COUNT (amount) AS COUNT,
	-- общее количество покупок
	SUM (amount) AS SUM_BUY,
	-- общая стоимость всех покупок
	MIN (amount) AS MIN_BUY,
	-- минимальная стоимость покупки
	MAX (amount) AS MAX_BUY,
	-- максимальная стоимость покупки
	ROUND ((AVG (amount::NUMERIC)),
	2) AS AVG_BUY,
	-- среднее значение
	PERCENTILE_DISC(0.50) WITHIN GROUP (
ORDER BY
	amount) AS Mediana,
	-- медиана покупки
	STDDEV (amount) AS Otklonenie
	-- стандартное отклонение стоимости покупки
FROM
	fantasy.events
WHERE
	amount > 0;



