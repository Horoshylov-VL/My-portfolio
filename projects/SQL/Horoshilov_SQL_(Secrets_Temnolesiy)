--Часть 2 Запрос 5 (средняя стоимость одной покупки на одного игрока, совершающего внутриигровые покупки)

WITH 
 CTE AS 
 (
 SELECT
 race,
 COUNT(DISTINCT transaction_id) AS unique_tran_id,
 SUM (amount) AS SUM_amount
 FROM fantasy.events AS e
 JOIN fantasy.users AS u USING (id)
 JOIN fantasy.race AS r USING (race_id)
 WHERE amount > 0
 GROUP BY race
 ORDER BY SUM_amount DESC
 ) --

 SELECT 
 race,
 ROUND ((SUM_amount ::NUMERIC  / unique_tran_id ::NUMERIC),2) AS AVG_amount_odnoy_pokupki
 FROM CTE
 ORDER BY SUM_amount DESC

