-- 2.3: Популярные эпические предметы:
-- Напишите ваш запрос здесь
-- Общее количество внутриигровых продаж в абсолютном и относительном выражении: 

--name: Запрос 2.3 (NEW)
WITH Item AS (
SELECT
	e.item_code,
	COUNT(*) FILTER (
	WHERE e.amount > 0) AS absolute_sales, -- абсолютное количество продаж предмета
	COUNT(DISTINCT e.id) FILTER (
	WHERE e.amount > 0) AS BUYER_USERS --  уникальные покупатели предмета
FROM
	fantasy.events AS e
GROUP BY
	e.item_code
	ORDER BY  BUYER_USERS DESC
)
SELECT
	i.game_items,
	I2.item_code,
	absolute_sales,
	BUYER_USERS,
	CAST(I2. absolute_sales AS NUMERIC) / SUM(I2.absolute_sales) OVER () AS doly_Sell,
	-- доля продаж предмета от общего числа
    CAST(I2.BUYER_USERS AS NUMERIC) / (SELECT COUNT(DISTINCT id) FROM fantasy.events  WHERE amount > 0) AS Users_Pokupa_predmeta
	-- доля покупателей предмета от общего числа
FROM
	Item AS I2
JOIN fantasy.items i ON
	I2.item_code = i.item_code
ORDER BY I2.BUYER_USERS DESC;


