--Часть 2 Запрос 3 (количество игроков, совершающих внутриигровые покупки, и их доля от общего количества;
--доля платящих игроков среди тех, кто совершал внутриигровые покупки;)
WITH
Pay_users AS (
  SELECT
    race,
    COUNT(DISTINCT u.id) AS Payers_user -- кол-во платных игроков
  FROM fantasy.events AS e
  JOIN fantasy.users AS u ON e.id = u.id
  JOIN fantasy.race AS r ON u.race_id = r.race_id
  WHERE payer = 1
  GROUP BY race
),
Paying_users AS (
  SELECT
    race,
    COUNT(DISTINCT u.id) AS Paying_user -- кол-во игроков, совершающих внутриигровые покупки (для каждой расы)
  FROM fantasy.events AS e
  JOIN fantasy.users AS u ON e.id = u.id
  JOIN fantasy.race AS r ON u.race_id = r.race_id
  WHERE e.amount > 0
  GROUP BY race
)
SELECT
  pup.race,
  pus.Payers_user,
  pup.Paying_user,
  CASE
    WHEN pup.Paying_user = 0 THEN 0
    ELSE ROUND(pus.Payers_user::numeric / pup.Paying_user::numeric, 2)
  END AS Doly_ot_pokupok -- доля платящих игроков среди тех, кто совершал внутриигровые покупки (для каждой расы)
FROM Pay_users AS pus  
JOIN Paying_users AS pup ON pus.race = pup.race
GROUP BY pup.race, pus.Payers_user, pup.Paying_user
ORDER BY Doly_ot_pokupok DESC;




