--Часть 2 Запрос 4 (среднее количество покупок на одного игрока, совершающего внутриигровые покупки)
 
WITH 
 total_transaction_id AS
 (
 SELECT
 race,
 COUNT (DISTINCT id) AS unique_users,
 COUNT (transaction_id) AS total_trans
 FROM fantasy.events AS e
 JOIN fantasy.users AS u USING (id)
 JOIN fantasy.race AS r USING (race_id)
 WHERE amount > 0
 GROUP BY race
 ORDER BY total_trans DESC
 ) --всего покупок на расу, совершающего внутриигровые покупки (для каждой расы)

SELECT
race,
(total_trans :: NUMERIC / unique_users :: NUMERIC)  AS AVG_trans_na_igroka
FROM  total_transaction_id
ORDER BY AVG_trans_na_igroka DESC

