-- Часть 2 Запрос 6 (средняя суммарная стоимость всех покупок на одного игрока, совершающего внутриигровые покупки.)
 
--средняя суммарная стоимость всех покупок на одного игрока, совершающего внутриигровые покупки.

WITH 
 SUM_amount_race AS
 (
 SELECT
 race,
 COUNT (DISTINCT id) AS unique_users,
 SUM (amount) AS SUM_amount
 FROM fantasy.events AS e
 JOIN fantasy.users AS u USING (id)
 JOIN fantasy.race AS r USING (race_id)
 WHERE amount > 0
 GROUP BY race
 ORDER BY SUM_amount DESC
 ) -- Общая стоимость покупок для кажой расы

 SELECT 
 race,
 ROUND ((SUM_amount ::NUMERIC  / unique_users ::NUMERIC  ),5) AS AVG_amount_na_igroka
 FROM SUM_amount_race
 ORDER BY SUM_amount DESC
 
 
 
 
